---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineArt from '../components/LineArt.astro';
---
<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="wrap nf">
    <div>
      <p class="eyebrow">Error 404</p>
      <h1>This page didn't make it past testing.</h1>
      <p>The link may be old or mistyped. Try one of these instead:</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/experience/">Experience</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
    <LineArt name="sound-meter" class="art" />
  </section>
</BaseLayout>

<style>
  .nf { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: center; padding-block: clamp(3rem, 9vw, 7rem); }
  .nf p { color: var(--ink-2); font-size: 1.15rem; }
  ul { padding-left: 1.2rem; font-size: 1.15rem; display: grid; gap: 0.4rem; }
  .nf :global(.art) { width: 100%; max-width: 18rem; justify-self: center; }
  @media (max-width: 48rem) { .nf { grid-template-columns: 1fr; } .nf :global(.art) { max-width: 10rem; } }
</style>
