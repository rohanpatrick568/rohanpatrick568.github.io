---
import { NAV, SITE, SOCIALS } from '../config/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="bar">
    <nav class="nav" aria-label="Main">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-list">
        <span class="open"><Icon name="menu" /></span>
        <span class="shut"><Icon name="close" /></span>
        <span class="sr-only">Menu</span>
      </button>
      <ul id="nav-list" class="nav-list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="site-title" href="/">{SITE.title}</a>
    <ul class="socials" aria-label="Elsewhere">
      {SOCIALS.map((s) => (
        <li>
          <a href={s.href} rel={s.href.startsWith('http') ? 'me noopener' : undefined} target={s.href.startsWith('http') ? '_blank' : undefined}>
            <Icon name={s.icon} label={s.href.startsWith('http') ? `${s.label} (opens in a new tab)` : s.label} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector('.site-header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) {
      header.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.96); border-bottom: 1px solid transparent; }
  @supports (backdrop-filter: blur(8px)) { .site-header { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px); } }
  .bar {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem;
    padding: 1.15rem var(--gutter); max-width: 90rem; margin-inline: auto;
  }
  .nav-list { display: flex; gap: clamp(1rem, 2vw, 2rem); list-style: none; margin: 0; padding: 0; }
  .nav-list a { text-decoration: none; font-weight: 500; font-size: 1.02rem; padding: 0.35rem 0; border-bottom: 2px solid transparent; }
  .nav-list a:hover { border-bottom-color: var(--line); color: var(--ink); }
  .nav-list a[aria-current='page'] { border-bottom-color: var(--ink); }
  .site-title { font-weight: 800; font-size: 1.3rem; text-decoration: none; white-space: nowrap; letter-spacing: -0.01em; }
  .socials { display: flex; justify-content: flex-end; gap: 1.4rem; list-style: none; margin: 0; padding: 0; }
  .socials a { display: grid; place-items: center; min-width: 2.75rem; min-height: 2.75rem; margin: -0.5rem; }
  .menu-toggle { display: none; }

  @media (max-width: 68rem) {
    .bar { grid-template-columns: auto 1fr auto; }
    .site-title { font-size: 1.1rem; text-align: center; overflow: hidden; text-overflow: ellipsis; }
    .menu-toggle {
      display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-left: -0.5rem;
      background: none; border: 0; color: var(--ink); cursor: pointer; border-radius: 0.5rem;
    }
    .menu-toggle .shut, :global(.is-open) .menu-toggle .open { display: none; }
    :global(.is-open) .menu-toggle .shut { display: block; }
    .nav-list {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; gap: 0; padding: 0.5rem var(--gutter) 1.25rem;
      background: #fff; border-bottom: 1px solid var(--line); box-shadow: 0 12px 24px rgba(17, 18, 20, 0.06);
    }
    :global(.is-open) .nav-list { display: flex; }
    .nav-list a { display: block; padding: 0.85rem 0; font-size: 1.15rem; border-bottom: 1px solid var(--line); }
    .nav-list a[aria-current='page'] { font-weight: 700; border-bottom-color: var(--line); }
    .socials { gap: 0.9rem; }
    .socials li:nth-child(n + 3) { display: none; }
  }
  @media (max-width: 26rem) {
    .site-title { font-size: 0.98rem; }
  }
</style>
