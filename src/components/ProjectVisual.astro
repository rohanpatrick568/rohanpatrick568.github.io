---
// A project's cover: phone screenshots, a photo, or its line drawing when there's no photo yet.
import { Picture } from 'astro:assets';
import Photo from './Photo.astro';
import LineArt from './LineArt.astro';
import { getPhoto, isPhotoKey } from '../lib/photos';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; ratio?: string; sizes?: string; loading?: 'eager' | 'lazy'; preferArt?: boolean }
const { project, ratio = '4:3', sizes, loading = 'lazy', preferArt = false } = Astro.props;
const { cover, art, screens } = project.data;
const shots = (screens ?? []).filter(isPhotoKey).map((k) => getPhoto(k)).filter((s) => s.image);
const hasPhoto = cover && isPhotoKey(cover) && getPhoto(cover).image;
const photoFit = hasPhoto ? getPhoto(cover as any).entry.fit : undefined;
const aspect = `aspect-ratio: ${ratio.replace(':', ' / ')}`;
---
{shots.length > 0 ? (
  <div class="screens" style={aspect}>
    {shots.map((s, i) => (
      <Picture src={s.image!} alt={s.entry.alt} widths={[240, 400]} sizes="12rem" formats={['avif', 'webp']} loading={loading} class:list={['screen', `screen--${i}`]} />
    ))}
  </div>
) : hasPhoto ? (
  <Photo photo={cover as any} ratio={ratio} sizes={sizes} loading={loading} fit={photoFit} class="visual" />
) : art && preferArt ? (
  <div class="art-panel" style={aspect}><LineArt name={art} /></div>
) : cover && isPhotoKey(cover) ? (
  <Photo photo={cover as any} ratio={ratio} art={art} compact={preferArt} class="visual" />
) : (
  <div class="art-panel" style={aspect}><LineArt name={art ?? 'filter-bank'} /></div>
)}

<style>
  .art-panel { display: grid; place-items: center; background: var(--paper-2); border-radius: inherit; padding: 12%; }
  .art-panel :global(svg) { width: 100%; height: 100%; max-height: 100%; }
  :global(.visual) { border-radius: inherit; }
  .screens {
    display: flex; justify-content: center; align-items: center; gap: 4%;
    background: var(--paper-2); border-radius: inherit; padding: 6% 7%; overflow: hidden;
  }
  .screens :global(picture) { display: contents; }
  .screens :global(img) {
    width: 28%; height: auto; border-radius: 0.9rem; box-shadow: 0 10px 30px rgba(17, 18, 20, 0.14);
    border: 1px solid var(--line); background: #fff;
  }
  .screens :global(img.screen--0), .screens :global(img.screen--2) { transform: translateY(5%); }
  .screens :global(img.screen--1) { width: 31%; }
</style>
